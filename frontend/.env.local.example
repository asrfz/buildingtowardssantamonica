# Copy to .env.local (same folder). Vite only loads env files that start with VITE_.
# https://vite.dev/guide/env-and-mode.html

# ── FastAPI backend ─────────────────────────────────────────────────────────
# Where your uvicorn app runs. Must match CORS in app/main.py (5173 allowed).
VITE_API_BASE=http://127.0.0.1:8000

# Same 24-char hex as DEFAULT_USER_ID in repo root .env (optional — in development
# the console also loads this from GET /integration/dev-context).
# VITE_DEFAULT_USER_ID=

# ── Cloudinary (browser upload widget + AdvancedImage) ─────────────────────
# Dashboard (cloud name is at the top): https://console.cloudinary.com/
#   → Product environment settings → copy "Cloud name"
#
# Unsigned upload preset (required for the widget in CloudinaryPlayground):
#   → Settings (gear) → Upload → Upload presets → Add upload preset
#   → Signing mode: Unsigned
#   → Folder / constraints optional; copy the preset *name*
#
# Signed preset: optional in this repo’s frontend (not read by React code today).
# Used if you add signed uploads; create under same Upload presets with Signing: Signed.
VITE_CLOUDINARY_CLOUD_NAME=dtdtgj8l7cd
VITE_CLOUDINARY_UPLOAD_PRESET=LAHACKS2026
# VITE_CLOUDINARY_SIGNED_PRESET=your_signed_upload_preset
