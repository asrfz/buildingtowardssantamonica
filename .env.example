# HomePulse AI — Environment Variables
# Copy this to .env and fill in your values. Never commit .env.

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/homepulse

# Cloudinary (Python SDK — pip install cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gmail SMTP (App Password — requires 2FA enabled on Google account)
# Generate at: myaccount.google.com/apppasswords
GMAIL_ADDRESS=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Arduino Serial
ARDUINO_SERIAL_PORT=/dev/ttyUSB0
# Windows: ARDUINO_SERIAL_PORT=COM3
ARDUINO_BAUD_RATE=9600

# Webcam
WEBCAM_INDEX=0

# FetchAI Agentverse
# All 10 agents use this seed (each appends its own suffix)
FETCHAI_AGENT_SEED=some_random_seed_phrase_here

# Anthropic Claude API
# Used by: triage_agent, vision (object + locate), monitor_agent, notification_agent, report_agent, voice correction ticks
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs (spoken guidance — voice_agent)
# https://elevenlabs.io/ — used with pygame for local MP3 playback
ELEVENLABS_API_KEY=
# Optional: default in app/config.py is Rachel (21m00Tcm4TlvDq8ikWAM)
# ELEVENLABS_VOICE_ID=

# App Settings
# FastAPI base URL for agent HTTP calls (use 127.0.0.1 on Windows to avoid localhost→IPv6 issues)
HOMEPULSE_API_BASE=http://127.0.0.1:8000
APP_ENV=development
DEFAULT_USER_ID=replace_with_seeded_user_object_id
# When voice guidance says the same line 4+ ticks in a row, email this address (demo).
# If empty, uses first emergency_contacts[].email on the DEFAULT_USER_ID user.
EMERGENCY_NOTIFY_EMAIL=
CANCEL_WINDOW_SECONDS=60
THRESHOLD_MULTIPLIER=2.5
CALIBRATION_HOURS=48

# Heartbeat Agent
# How many seconds of silence before sensor is considered offline
HEARTBEAT_TIMEOUT_SECONDS=120

# Report Agent
# How many days between weekly digest emails
REPORT_SCHEDULE_DAYS=7
